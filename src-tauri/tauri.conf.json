{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dazi",
  "version": "0.1.0",
  "identifier": "com.wxw.dazi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dazi",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "本地任务文件夹管理 + Claude Code 一键交接",
    "longDescription": "Dazi 把每个任务变成一个本地文件夹，集中管理 README、参考资料与归档；一键把任务上下文交接给 Claude Code CLI。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "installWebView2Mode": "downloadBootstrapper"
      }
    }
  }
}
